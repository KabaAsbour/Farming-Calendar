# Application Environment Configuration
# Farming Calendar SaaS

# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Localization (Default: fr for Guinea & West Africa, en supported)
DEFAULT_LOCALE="fr"

# PostgreSQL / Cloud SQL Database Configuration
# Runtime connection parameters (Object Method)
SQL_HOST="127.0.0.1"
SQL_USER="farming_user"
SQL_PASSWORD="your_secure_password"
SQL_DB_NAME="farming_calendar"

# Schema Management & Migration Parameters
SQL_ADMIN_USER="farming_admin"
SQL_ADMIN_PASSWORD="your_admin_password"

# Firebase Auth Configuration (Provisioned via AI Studio OAuth/Firebase integration)
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_API_KEY=""
